{
  "palette": {
    "$type": "color",
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "navy-900": { "$value": { "colorSpace": "srgb", "components": [0.0431, 0.1216, 0.2], "hex": "#0b1f33" } },
    "ink-900": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "hex": "#0f172a" } },
    "slate-100": { "$value": "#f1f5f9" },
    "slate-300": { "$value": "#cbd5e1" },
    "slate-400": { "$value": "#94a3b8" },
    "slate-500": { "$value": "rgb(100, 116, 139)" },
    "slate-600": { "$value": "#475569" },
    "gray-500": { "$value": "#6b7280" },
    "blue-400": { "$value": "#60a5fa" },
    "blue-600": { "$value": "#2563eb" }
  },
  "color": {
    "$type": "color",
    "light": {
      "surface": { "default": { "$value": "{palette.white}" } },
      "text": {
        "primary": { "$value": "{palette.navy-900}" },
        "secondary": { "$value": "{palette.slate-600}" },
        "muted": { "$value": "{palette.slate-500}" }
      },
      "border": { "input": { "$value": "{palette.gray-500}" } },
      "focus": { "ring": { "$value": "{palette.blue-600}" } }
    },
    "dark": {
      "surface": { "default": { "$value": "{palette.ink-900}" } },
      "text": {
        "primary": { "$value": "{palette.slate-100}" },
        "secondary": { "$value": "{palette.slate-300}" },
        "muted": { "$value": "{palette.slate-400}" }
      },
      "border": { "input": { "$value": "{palette.slate-500}" } },
      "focus": { "ring": { "$value": "{palette.blue-400}" } }
    }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "body": { "$value": { "value": 16, "unit": "pt" } },
      "caption": { "$value": { "value": 12, "unit": "pt" } }
    }
  },
  "size": {
    "touch": {
      "$type": "dimension",
      "ios": {
        "button": { "$value": { "value": 44, "unit": "pt" } },
        "tab": { "$value": { "value": 49, "unit": "pt" } }
      },
      "android": {
        "button": { "$value": { "value": 48, "unit": "dp" } }
      },
      "web": {
        "icon-button": { "$value": { "value": 32, "unit": "px" } },
        "link-row": { "$value": { "value": 2.5, "unit": "rem" } }
      }
    }
  }
}
