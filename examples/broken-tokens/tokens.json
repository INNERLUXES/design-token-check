{
  "color": {
    "$type": "color",
    "base": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1] } },
    "surface": { "$value": "{color.base}" },
    "text": {
      "primary": { "$value": "{color.text.body}" },
      "body": { "$value": "{color.text.default}" },
      "default": { "$value": "{color.text.primary}" }
    },
    "accent": { "$value": "{color.brand}" },
    "border": { "$value": "#12345" }
  },
  "size": {
    "touch": {
      "button": { "$value": { "value": 44, "unit": "pt" } }
    }
  }
}
